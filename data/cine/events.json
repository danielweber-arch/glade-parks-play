 },
 "distanceNudgeTries": {
  "value": 20,
  "source": "CineCamera.ToDist literal (r38 m1), moved to data N200 r42",
  "why": "Most nudges ToDist makes each way before it gives up and lets the shot fail its fit."
 },
 "clearMarginMeters": {
  "value": 0.01,
  "source": "Staging.ClearOfBuildings literal (562d1e0), moved to data N200 r42",
  "why": "Meters past a building's radius plus a person's or prop's radius that the staged group stands, so touching counts as clear."
 },
 "sightMarginMeters": {
  "value": 0.005,
  "source": "N199 real fix r43 u5",
  "why": "Meters added to a building's radius plus a person's or prop's radius when the camera checks its sight line to every staged mark. Kept below clearMarginMeters so a cleared mark (positions round to 1 mm) is never judged behind its own clearance ring."
 },
 "stageFrontDegrees": {
